{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "vcs": {
    "useIgnoreFile": true,
    "enabled": true,
    "clientKind": "git"
  },
  "files": {
    "includes": [
      "**",
      "!**/.agents",
      "!**/node_modules",
      "!**/dist",
      "!**/worker-configuration.d.ts",
      "!**/routeTree.gen.ts",
      "!**/public/**/*.svg",
      "!**/public/static"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {},
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "suspicious": {
        "noUnknownAtRules": "off"
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "warn"
        }
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "jsxQuoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "space"
    }
  },
  "tailwind": {
    "mergeFunctions": ["cn", "clsx", "twMerge", "tw", "tw.*"],
    "variantFunctions": ["cva"]
  }
}
