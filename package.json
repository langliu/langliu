{
  "name": "langliu",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "void deploy --platform cloudflare",
    "cf-typegen": "void prepare",
    "db:migrate:local": "void db migrate",
    "db:migrate:remote": "void db migrate --remote",
    "typecheck": "void prepare && tsc --noEmit",
    "lint": "biome lint . --files-ignore-unknown=true",
    "check": "biome check . --files-ignore-unknown=true",
    "format": "biome format --write . --files-ignore-unknown=true"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@cfworker/json-schema": "4.1.6",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "better-auth": "1.7.28",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.81.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-router-devtools": "1.167.4",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "lefthook": "2.2.4",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.4.0",
    "void": "^1.12.0",
    "wrangler": "4.168.0"
  }
