{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@langliu/ui/ui": ["./src/ui"],
      "@langliu/ui/ui/*": ["./src/ui/*"],
      "@langliu/ui/lib/*": ["./src/lib/*"],
      "@langliu/ui/lib/utils": ["./src/lib/utils.ts"],
      "@langliu/ui/hooks/*": ["./src/hooks/*"]
    }
  },
  "include": ["src"]
}
